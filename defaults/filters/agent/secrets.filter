# agent/secrets: what a sandboxed command must not read. Rules apply under
# the home. Named in a profile's `read`: each exclude is unreadable.
version 1

# keys and credentials
exclude /.ssh
exclude /.gnupg
exclude /.aws
exclude /.azure
exclude /.kube
exclude /.netrc
exclude /.git-credentials
exclude /.pypirc
exclude /.gem/credentials
exclude /.cargo/credentials.toml
exclude /.appstoreconnect
exclude /.minisign
exclude /.config/{gh,gcloud,op,agebox,anthropic,borg,plakar,configstore}
exclude /.config/rclone/rclone.conf
exclude /.claude/.credentials.json
exclude /.codex/auth.json
exclude /.gemini
exclude /.copilot
exclude /.local/share/keyrings

# macOS app data, as wholes: browsers, password managers, mail, calendars,
# messages and every other app's tokens
exclude /Library/{Application Support,Containers,Group Containers,Preferences}
exclude /Library/{Keychains,Cookies,Safari,Messages,Mail,Calendars,Accounts}
exclude /Library/{CloudStorage,Mobile Documents,Thunderbird}

# the same kinds of data on Linux
exclude /.mozilla
exclude /.thunderbird
exclude /.config/{google-chrome,chromium,BraveSoftware,1Password}

# personal folders, shell histories
exclude /{Dropbox,.dropbox,Downloads,Documents,Desktop}
exclude /{.bash_history,.zsh_history,.psql_history}
